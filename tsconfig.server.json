    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts"]
}
